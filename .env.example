# Direct PostgreSQL Connection String (Optional if using Supabase client)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.fqycspmoapmisnbfhukn.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fqycspmoapmisnbfhukn.supabase.co:5432/postgres
