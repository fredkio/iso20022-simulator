# Supabase Configuration for ISO 20022 Multi-Bank Simulation Environment
NEXT_PUBLIC_SUPABASE_URL=https://fqycspmoapmisnbfhukn.supabase.co

# Supabase Service Role Key (Required for server-side switch & ledger persistence)
# Find this in your Supabase Dashboard: Project Settings -> API -> Project API keys -> service_role (secret)
